<div class="max-w-xl mx-auto mt-10 px-4">
  <h1 class="text-3xl font-bold mb-6">
    New System Information
  </h1>

  <div class="border border-gray-300 rounded-lg p-6 bg-white shadow-sm">
    <%= form_with url: sys_infos_path, multipart: true do |form| %>
      <div class="mb-4">
        <%= label_tag :name,
            "Server name",
            class: "block font-medium mb-1" %>

        <%= text_field_tag :name,
            nil,
            class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>

      <div class="mb-4">
        <%= form.label :rack,
            "Rack",
            class: "block font-medium mb-1" %>

        <%= form.text_field :rack,
            class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>

      <div class="mb-4">
        <%= form.label :u_position,
            "U Position",
            class: "block font-medium mb-1" %>

        <%= form.number_field :u_position,
            class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>

      <div class="mb-4">
        <%= form.label :slot,
            "Slot",
            class: "block font-medium mb-1" %>

        <%= form.text_field :slot,
            class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>

        <div class="mb-4">
        <%= form.label :notes,
            "Notes (optional)",
            class: "block font-medium mb-1" %>

        <%= form.text_field :notes,
            class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>

      <div class="mb-6">
        <%= label_tag :data,
            "Redfish JSON file",
            class: "block font-medium mb-1" %>

        <%= file_field_tag :data,
            accept: ".json",
            class: "block w-full border border-gray-300 rounded px-3 py-2" %>
      </div>

      <div class="flex items-center gap-4">
        <%= submit_tag "Upload JSON",
            class: "px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 cursor-pointer" %>

        <%= link_to "Back to systems",
            sys_infos_path,
            class: "text-blue-600 hover:underline" %>
      </div>
    <% end %>
  </div>
</div>