<div class="max-w-5xl mx-auto mt-10 px-4">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold">
      System Information
    </h1>

    <%= link_to "Add another server",
        new_sys_info_path,
        class: "inline-block px-4 py-2 bg-blue-600 text-white rounded-md hover:bg-blue-700" %>
  </div>

  <div class="overflow-hidden border border-gray-300 rounded-lg">
    <table class="w-full border-collapse text-left">
      <thead class="bg-gray-100">
        <tr>
          <th class="px-5 py-3 border-b border-gray-300">Name</th>
          <th class="px-5 py-3 border-b border-gray-300">Model</th>
          <th class="px-5 py-3 border-b border-gray-300">Rack</th>
          <th class="px-5 py-3 border-b border-gray-300">U Position</th>
          <th class="px-5 py-3 border-b border-gray-300">Action</th>
        </tr>
      </thead>

      <tbody>
        <% @sys_infos.each do |sys_info| %>
          <tr class="odd:bg-white even:bg-gray-50 hover:bg-gray-100">
            <td class="px-5 py-4 border-b border-gray-200 font-medium">
              <%= sys_info.name.presence || "Unnamed server" %>
            </td>

            <td class="px-5 py-4 border-b border-gray-200">
              <%= sys_info.system_model.presence || "Unavailable" %>
            </td>

            <td class="px-5 py-4 border-b border-gray-200">
              <%= sys_info.rack.presence || "-" %>
            </td>

            <td class="px-5 py-4 border-b border-gray-200">
              <%= sys_info.u_position.presence || "-" %>
            </td>

            <td class="px-5 py-4 border-b border-gray-200">
              <%= link_to "View",
                  sys_info_path(sys_info),
                  class: "text-blue-600 font-medium hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>