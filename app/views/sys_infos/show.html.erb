<div class="max-w-2xl mx-auto mt-10">
  <h1 class="text-3xl font-bold mb-6">
    <%= @sys_info.name %>
  </h1>

  <% if @json_data %>
    <div class="border rounded p-4 space-y-3">
      <p>
        <strong>System model:</strong>
        <%= @json_data["Model"] %>
      </p>

      <p>
        <strong>Max memory:</strong>
        <%= @json_data["MemorySummary"]["TotalSystemMemoryGiB"] %> GB
      </p>

      <p>
        <strong>Logical CPUs:</strong>
        <%= @json_data["ProcessorSummary"]["LogicalProcessorCount"] %>
      </p>

      <p><strong>Rack:</strong> <%= @sys_info.rack %></p>
      <p><strong>U Position:</strong> <%= @sys_info.u_position %></p>
      <p><strong>Slot</strong> <%= @sys_info.u_position %></p>


    </div>
  <% else %>
    <p>No system data found.</p>
  <% end %>

  <h2 class="text-2xl font-bold mt-10 mb-4">
    JSON import history
  </h2>

  <% if @current_import %>
    <% current_index = @imported_jsons.index(@current_import) %>

    <div class="border rounded p-4">
      <p>
        Import:
        <%= current_index + 1 %>
        of
        <%= @imported_jsons.length %>
      </p>

      <p>
        Imported:
        <%= @current_import.created_at.strftime("%d %B %Y at %H:%M") %>
      </p>

      <div class="mt-4 flex gap-4">
        <% if current_index > 0 %>
          <% previous_import = @imported_jsons[current_index - 1] %>

          <%= link_to "← Previous state",
              sys_info_path(
                @sys_info,
                import_id: previous_import.id
              ),
              class: "text-blue-600 hover:underline" %>
        <% end %>

        <% if current_index < @imported_jsons.length - 1 %>
          <% next_import = @imported_jsons[current_index + 1] %>

          <%= link_to "Next state →",
              sys_info_path(
                @sys_info,
                import_id: next_import.id
              ),
              class: "text-blue-600 hover:underline" %>
        <% end %>
      </div>

      <div class="mt-4">
        <% if params[:show_json] == "true" %>
          <%= link_to "Hide raw JSON",
              sys_info_path(
                @sys_info,
                import_id: @current_import.id
              ),
              class: "text-blue-600 hover:underline" %>
        <% else %>
          <%= link_to "View raw JSON",
              sys_info_path(
                @sys_info,
                import_id: @current_import.id,
                show_json: true
              ),
              class: "text-blue-600 hover:underline" %>
        <% end %>
      </div>

      <% if params[:show_json] == "true" %>
        <pre class="mt-4 p-4 border rounded overflow-auto"><%= JSON.pretty_generate(JSON.parse(@current_import.raw_json)) %></pre>
      <% end %>
    </div>
  <% else %>
    <p>No JSON imports found.</p>
  <% end %>

  <h2 class="text-2xl font-bold mt-10 mb-4">
    Upload a new state
  </h2>

  <%= form_with url: upload_import_sys_info_path(@sys_info),
                multipart: true do %>
    <div>
      <%= file_field_tag :data, accept: ".json" %>
    </div>

    <div class="mt-3">
      <%= submit_tag "Upload new JSON state" %>
    </div>
    
  <% end %>

  <div class="mt-8 flex gap-4">
    <%= link_to "Back to all systems",
        sys_infos_path,
        class: "text-blue-600 hover:underline" %>

    <%= link_to "Edit system",
        edit_sys_info_path(@sys_info),
        class: "text-blue-600 hover:underline" %>

    <%= button_to "Delete system",
        sys_info_path(@sys_info),
        method: :delete,
        data: { turbo_confirm: "Are you sure?" },
        class: "text-red-600 hover:underline" %>
  </div>
</div>