<div class="max-w-2xl mx-auto mt-10 px-4 ">
  <h1 class="text-3xl font-bold mb-6">
    <%= @sys_info.name %>
  </h1>

  <% if @json_data %>
    <div class="border rounded-lg p-5 space-y-3 bg-white shadow-sm">
      <p>
        <strong>System model:</strong>
        <%= @json_data["Model"] %>
      </p>

      <p>
        <strong>Max memory:</strong>
        <%= @json_data.dig("MemorySummary", "TotalSystemMemoryGiB") %> GB
      </p>

      <p>
        <strong>Logical CPUs:</strong>
        <%= @json_data.dig("ProcessorSummary", "LogicalProcessorCount") %>
      </p>

      <p>
        <strong>Rack:</strong>
        <%= @sys_info.rack %>
      </p>

      <p>
        <strong>U Position:</strong>
        <%= @sys_info.u_position %>
      </p>

      <p>
        <strong>Slot:</strong>
        <%= @sys_info.slot %>
      </p>

      <p>
        <strong>Notes:</strong>
        <%= @sys_info.notes.presence || "No notes added" %>
      </p>
    </div>
  <% else %>
    <p class="text-gray-600">No system data found.</p>
  <% end %>

  <h2 class="text-2xl font-bold mt-10 mb-4">
    JSON import history
  </h2>

  <% if @current_import %>
    <% current_index = @imported_jsons.index(@current_import) %>

    <div class="border rounded-lg p-5 bg-white shadow-sm">
      <div class="space-y-2">
        <p>
          <strong>Import:</strong>
          <%= current_index + 1 %>
          of
          <%= @imported_jsons.length %>
        </p>

        <p>
          <strong>Imported:</strong>
          <%= @current_import.created_at.strftime("%d %B %Y at %H:%M") %>
        </p>
      </div>

      <div class="mt-5 flex justify-between">
        <div>
          <% if current_index > 0 %>
            <% previous_import = @imported_jsons[current_index - 1] %>

            <%= link_to "← Previous state",
                sys_info_path(
                  @sys_info,
                  import_id: previous_import.id
                ),
                class: "text-blue-600 hover:underline" %>
          <% end %>
        </div>

        <div>
          <% if current_index < @imported_jsons.length - 1 %>
            <% next_import = @imported_jsons[current_index + 1] %>

            <%= link_to "Next state →",
                sys_info_path(
                  @sys_info,
                  import_id: next_import.id
                ),
                class: "text-blue-600 hover:underline" %>
          <% end %>
        </div>
      </div>

      <div class="mt-5">
        <% if params[:show_json] == "true" %>
          <%= link_to "Hide raw JSON",
              sys_info_path(
                @sys_info,
                import_id: @current_import.id
              ),
              class: "text-blue-600 hover:underline" %>
        <% else %>
          <%= link_to "View raw JSON",
              sys_info_path(
                @sys_info,
                import_id: @current_import.id,
                show_json: true
              ),
              class: "text-blue-600 hover:underline" %>
        <% end %>
      </div>

      <% if params[:show_json] == "true" %>
        <pre class="mt-4 p-4 bg-gray-100 border rounded-lg overflow-auto text-sm whitespace-pre-wrap break-words"><%= JSON.pretty_generate(JSON.parse(@current_import.raw_json)) %></pre>
      <% end %>
    </div>
  <% else %>
    <p class="text-gray-600">No JSON imports found.</p>
  <% end %>

  <h2 class="text-2xl font-bold mt-10 mb-4">
    Upload a new state
  </h2>

  <div class="border rounded-lg p-5 bg-white shadow-sm">
    <%= form_with url: upload_import_sys_info_path(@sys_info),
                  multipart: true do %>
      <div>
        <%= file_field_tag :data,
            accept: ".json",
            class: "block w-full border rounded p-2" %>
      </div>

      <div class="mt-4">
        <%= submit_tag "Upload new JSON state",
            class: "px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 cursor-pointer" %>
      </div>
    <% end %>
  </div>

  <div class="mt-8 flex items-center gap-5 border-t pt-5">
    <%= link_to "Back to all systems",
        sys_infos_path,
        class: "text-blue-600 hover:underline" %>

    <%= link_to "Edit system",
        edit_sys_info_path(@sys_info),
        class: "text-blue-600 hover:underline" %>

    <%= button_to "Delete system",
        sys_info_path(@sys_info),
        method: :delete,
        data: { turbo_confirm: "Are you sure?" },
        class: "text-red-600 hover:underline cursor-pointer" %>
  </div>
</div>